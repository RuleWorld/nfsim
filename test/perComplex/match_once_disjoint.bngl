# MatchOnce on a disjoint pattern whose two parts the rule both changes. Each
# scaffold S holds one A and two B, so A(x~0).B(y~0) matches it twice, and NFsim
# keeps the second match as a clone of the first. BioNetGen's network gives the
# rule one reaction per complex at k: 2000*(1-exp(-0.5)) = 786.9 A flipped at
# t = 500.
begin model
begin parameters
  k   1e-3
  X0  2000
end parameters
begin molecule types
  S(a,b1,b2)
  A(s,x~0~1)
  B(s,y~0~1)
end molecule types
begin seed species
  S(a!1,b1!2,b2!3).A(s!1,x~0).B(s!2,y~0).B(s!3,y~0)  X0
end seed species
begin observables
  Molecules Ax1 A(x~1)
end observables
begin reaction rules
  Dmo: {MatchOnce}A(x~0).B(y~0) -> A(x~1).B(y~1) k
end reaction rules
end model
begin actions
  writeXML()
end actions
