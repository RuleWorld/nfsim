# Regression for a rate law that reads a table function of time (#142).
# The linear table ramps from 0 at t = 0 to 1 at t = 2 and holds 1 after.
# Nothing can fire at t = 0, where it reads 0, and NFsim read the table only
# when a reaction fired, so A0 stayed at N.  The mean of A0 is
# N*exp(-t^2/4) until t = 2 and N*exp(-1-(t-2)) after.
begin model
begin parameters
  N 1000
end parameters
begin molecule types
  A(s~0~1)
end molecule types
begin seed species
  A(s~0) N
end seed species
begin observables
  Molecules A0 A(s~0)
end observables
begin functions
  f() = tfun([0, 2], [0, 1], time)
end functions
begin reaction rules
  R: A(s~0) -> A(s~1) f()
end reaction rules
end model
begin actions
  writeXML()
end actions
