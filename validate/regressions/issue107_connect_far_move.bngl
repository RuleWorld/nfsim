begin model
begin parameters
 km 0.2
 kp 1
 kh 5
end parameters
begin compartments
 EC 3 1
 PM 2 1 EC
 CP 3 1 PM
end compartments
begin molecule types
 X(r)
 C(l,r,f~0~1)
 A(c,s~U~P)
end molecule types
begin seed species
 @CP:X(r!1).C(l!1,r!2,f~0).C(l!2,r!3,f~0).C(l!3,r!4,f~0).C(l!4,r!5,f~0).A(c!5,s~U) 200
end seed species
begin observables
 Molecules AP A(s~P)
 Molecules AEC A()@EC
end observables
begin reaction rules
 move: X()@CP -> X()@EC km MoveConnected
 phos: A(s~U)@EC -> A(s~P)@EC kp
 heal: C(r!1,f~0).A(c!1) -> C(r!1,f~1).A(c!1) kh
 unheal: C(f~1) -> C(f~0) kh
end reaction rules
end model
writeXML()
