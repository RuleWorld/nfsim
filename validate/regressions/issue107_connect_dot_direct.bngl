begin model
begin parameters
 ku 10
 kp 1
end parameters
begin molecule types
 A(x,s~U~P)
 B(a,t~0~1)
end molecule types
begin seed species
 A(x!1,s~U).B(a!1,t~0) 200
end seed species
begin observables
 Molecules AP A(s~P)
end observables
begin reaction rules
 unbind: A(x!1).B(a!1) -> A(x) + B(a) ku
 phos: A(s~U).B(t~0) -> A(s~P).B(t~0) kp
end reaction rules
end model
writeXML()
