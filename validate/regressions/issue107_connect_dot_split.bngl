begin model
begin parameters
 ku 10
 kp 1
end parameters
begin molecule types
 A(x,s~U~P)
 X(a,y)
 Y(x,b)
 B(y)
end molecule types
begin seed species
 A(x!1,s~U).X(a!1,y!2).Y(x!2,b!3).B(y!3) 200
end seed species
begin observables
 Molecules AP A(s~P)
 Molecules XY X(y!1).Y(x!1)
end observables
begin reaction rules
 unbind: X(y!1).Y(x!1) -> X(y) + Y(x) ku
 phos: A(s~U).B() -> A(s~P).B() kp
end reaction rules
end model
writeXML()
