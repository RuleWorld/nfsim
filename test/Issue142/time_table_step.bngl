# Regression for a rate law that reads a table function of time (#142).
# The step table is 0 until t = 2 and 0.5 after, so nothing can fire until
# t = 2; NFsim read the table only when a reaction fired, and A0 stayed at N.
# Each A leaves on its own: the mean of A0 is N*exp(-0.5*(t-2)) after t = 2.
begin model
begin parameters
  N 1000
end parameters
begin molecule types
  A(s~0~1)
end molecule types
begin seed species
  A(s~0) N
end seed species
begin observables
  Molecules A0 A(s~0)
end observables
begin functions
  f() = tfun([0, 2], [0, 0.5], time, method=>"step")
end functions
begin reaction rules
  R: A(s~0) -> A(s~1) f()
end reaction rules
end model
begin actions
  writeXML()
end actions
