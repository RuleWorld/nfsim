# Regression for issue #78: NFsim must preserve an absolute start time for
# output and for functions that reference time(). The rule has a constant rate:
# a rate law that reads time() is refused at load (issue #112).
begin model

begin parameters
  k 1
end parameters

begin molecule types
  X()
end molecule types

begin seed species
  X() 0
end seed species

begin observables
  Molecules Xtot X()
end observables

begin functions
  stimulus() = time()
end functions

begin reaction rules
  R: 0 -> X() k
end reaction rules

end model

begin actions
  writeXML()
end actions
