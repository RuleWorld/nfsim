begin model
begin parameters
  kopen 1
  kR 1
end parameters
begin molecule types
  A(b,c)
  B(a,d)
  C()
end molecule types
begin species
  A(b!1,c!2).B(a!1,d!2) 1
  C() 1
end species
begin observables
  Molecules Afree A(b)
  Molecules Aring A(c!+)
end observables
begin reaction rules
  open: A(c!1).B(d!1) -> A(c).B(d) kopen
  split: A(b!1).B(a!1) + C() -> A(b) + B(a) + C() kR
end reaction rules
end model
writeXML()
